# 使用官方轻量级 Python 镜像作为基础镜像
# python:3.10-slim 是一个基于 Debian 的轻量级 Python 3.10 镜像
# 相比完整的 Python 镜像，它体积更小，适合生产环境
FROM python:3.10-slim

# 设置工作目录
# 后续的命令将在这个目录中执行
WORKDIR /app

# 复制依赖文件到容器中
# requirements.txt 包含了项目所需的所有 Python 依赖
COPY requirements.txt .

# 安装依赖
# --no-cache-dir 选项避免缓存安装包，减小镜像体积
# -i https://pypi.tuna.tsinghua.edu.cn/simple 使用清华大学的 PyPI 镜像源，加快安装速度
RUN pip install --no-cache-dir -r requirements.txt -i https://pypi.tuna.tsinghua.edu.cn/simple

# 复制项目代码到容器中
# ./app 目录包含了项目的核心代码
# ./config 目录包含了项目的配置文件
COPY ./app /app/app
COPY ./config /app/config

# 设置环境变量
# PYTHONPATH=/app 确保 Python 能够找到项目的模块
# KUBECONFIG_PATH=/app/config/kubeconfig 指定 kubeconfig 文件的路径
ENV PYTHONPATH=/app
ENV KUBECONFIG_PATH=/app/config/kubeconfig

# 暴露 FastAPI 默认端口
# 告诉 Docker 容器在运行时监听 8000 端口
# 注意：这只是一个声明，实际的端口映射需要在运行容器时通过 -p 参数指定
EXPOSE 8000

# 启动服务
# 使用 uvicorn 作为 ASGI 服务器来运行 FastAPI 应用
# app.main:app 指定应用的入口点，其中 app 是模块名，main 是模块中的变量名
# --host 0.0.0.0 允许从容器外部访问
# --port 8000 指定服务监听的端口
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]

# 现在你再看这行命令，应该就完全懂了：
# uvicorn: 喊出服务员的名字。
# app.main:app: 告诉服务员，后厨的厨师在哪（在 app 文件夹下的 main.py 文件里，那个叫 app 的对象）。
# --host 0.0.0.0: 告诉服务员，不仅要接待本地客人，还要接待外面（容器外 / 互联网）来的客人。
# --port 8000: 告诉服务员，在 8000 号门口站岗。
